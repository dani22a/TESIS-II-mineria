{
  "name": "WF-05 Management report distribution",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * 1"
            }
          ]
        }
      },
      "id": "119f0b4e-174f-4a2d-8f7a-02a7327e78df",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.TB_API_URL }}/reports/management.pdf",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.N8N_API_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "date_from",
              "value": "={{ $now.minus({days: 7}).toISO() }}"
            }
          ]
        }
      },
      "id": "f0530fbb-0c2d-418d-893e-bbdfdb75f15c",
      "name": "Export management report (PDF, last 7 days)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $env.ALERT_CHANNEL }}",
              "rightValue": "email",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "4dc3e5e3-40f9-48a6-868f-77bebf79b4f7",
      "name": "Report: channel is email?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        520,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.ALERT_EMAIL_FROM }}",
        "toEmail": "={{ $env.ALERT_EMAIL_TO }}",
        "subject": "TB screening - weekly management report",
        "emailFormat": "text",
        "text": "={{ 'Weekly management report attached. Carries the DEMO notice when applicable.' }}",
        "options": {
          "attachments": "data"
        }
      },
      "id": "189de102-e4e6-4023-8256-7b74dda74bc6",
      "name": "Report: send email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        780,
        300
      ],
      "credentials": {
        "smtp": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "TB SMTP"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ALERT_WEBHOOK_URL }}",
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "data"
            }
          ]
        }
      },
      "id": "5134610f-8c41-49e7-8473-ec2b73751ce2",
      "name": "Report: send webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1040,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TB_API_URL }}/ops/events",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.N8N_API_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({workflow: 'WF-05', event: 'report_distributed', outcome: 'success', detail: {format: 'pdf', channel: $env.ALERT_CHANNEL || 'webhook'}}) }}"
      },
      "id": "28a8e301-8ac6-4db4-8521-2471e915d935",
      "name": "Log distribution",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1300,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
  ],
  "connections": {
    "Report: channel is email?": {
      "main": [
        [
          {
            "node": "Report: send email",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Report: send webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Schedule": {
      "main": [
        [
          {
            "node": "Export management report (PDF, last 7 days)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Export management report (PDF, last 7 days)": {
      "main": [
        [
          {
            "node": "Report: channel is email?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Report: send email": {
      "main": [
        [
          {
            "node": "Log distribution",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Report: send webhook": {
      "main": [
        [
          {
            "node": "Log distribution",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "tags": [
    {
      "name": "tb-screening"
    }
  ],
  "meta": {
    "note": "Set env TB_API_URL and N8N_API_TOKEN; see workflows/README.md"
  }
}
