{
  "name": "WF-01 Import metadata and image batches",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 2 * * *"
            }
          ]
        }
      },
      "id": "538dd3d9-930e-4f23-8cab-3fa12e0c8c9a",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {},
      "id": "affffcc4-1167-4796-880a-3ed0bbdab84b",
      "name": "Manual trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        260,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $env.IMPORT_SOURCE_URL }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "5a45a206-bc41-4837-8748-2bcf4c5410a4",
      "name": "Authorized source configured?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        520,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.IMPORT_SOURCE_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.IMPORT_SOURCE_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "cde89ff7-4b7a-4f95-83a0-89ff588f6ff1",
      "name": "Fetch batch from authorized source",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "// Source contract: JSON array (or {items: []}) of {institution, notes, image_url?}.\n// Only these three fields are kept: no patient identifiers are accepted.\nconst out = [];\nfor (const it of $input.all()) {\n  const rows = Array.isArray(it.json) ? it.json : (it.json.items || [it.json]);\n  for (const r of rows) out.push({json: {institution: String(r.institution || '').slice(0, 200) || null,\n    notes: String(r.notes || '').slice(0, 1900) || null, image_url: r.image_url || null}});\n}\nreturn out;"
      },
      "id": "dd6ae956-3380-4a71-836a-19d871441cb3",
      "name": "Normalize batch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// No source configured: 3 clearly flagged demo cases WITHOUT images.\nreturn [1, 2, 3].map(i => ({json: {institution: 'DEMO Institution', notes: '[DEMO IMPORT] synthetic case ' + i, image_url: null}}));"
      },
      "id": "c25a3491-54f8-4638-8f30-cb8f2934718a",
      "name": "Demo data (fallback)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        300
      ]
    },
    {
      "parameters": {},
      "id": "90dfe479-cc23-4b40-84d4-f7275ee6d4ad",
      "name": "Normalized items",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1560,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TB_API_URL }}/cases",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.N8N_API_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({institution: $json.institution, notes: $json.notes}) }}"
      },
      "id": "bf09b0ea-6b63-44b2-8c51-41277344a63e",
      "name": "Create case",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1820,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $('Normalized items').item.json.image_url }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "17f18942-87c5-4159-808f-861e97f2f480",
      "name": "Has image_url?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2080,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Normalized items').item.json.image_url }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "id": "bbc0bf6d-05fd-4870-862f-aea4454741fd",
      "name": "Download image",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2340,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TB_API_URL }}/cases/{{ $('Create case').item.json.id }}/image",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.N8N_API_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "data"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "id": "d91a53d1-1be2-437f-83d9-400c2bd7186d",
      "name": "Upload image to case",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2600,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "return [{json: {created: $('Create case').all().length}}];"
      },
      "id": "aead02a0-4597-47e9-8c55-517d3e3d4edf",
      "name": "Summarize import",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2860,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TB_API_URL }}/ops/events",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.N8N_API_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({workflow: 'WF-01', event: 'import_batch', outcome: 'success', detail: {created: $json.created}}) }}"
      },
      "id": "e1e8a649-b11a-4801-8737-4ec36be0eca2",
      "name": "Log import event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3120,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
  ],
  "connections": {
    "Schedule": {
      "main": [
        [
          {
            "node": "Authorized source configured?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual trigger": {
      "main": [
        [
          {
            "node": "Authorized source configured?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Authorized source configured?": {
      "main": [
        [
          {
            "node": "Fetch batch from authorized source",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Demo data (fallback)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch batch from authorized source": {
      "main": [
        [
          {
            "node": "Normalize batch",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize batch": {
      "main": [
        [
          {
            "node": "Normalized items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Demo data (fallback)": {
      "main": [
        [
          {
            "node": "Normalized items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalized items": {
      "main": [
        [
          {
            "node": "Create case",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create case": {
      "main": [
        [
          {
            "node": "Has image_url?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has image_url?": {
      "main": [
        [
          {
            "node": "Download image",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Summarize import",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Download image": {
      "main": [
        [
          {
            "node": "Upload image to case",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Upload image to case": {
      "main": [
        [
          {
            "node": "Summarize import",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Summarize import": {
      "main": [
        [
          {
            "node": "Log import event",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "tags": [
    {
      "name": "tb-screening"
    }
  ],
  "meta": {
    "note": "Set env TB_API_URL and N8N_API_TOKEN; see workflows/README.md"
  }
}
