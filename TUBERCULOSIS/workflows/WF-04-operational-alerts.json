            "index": 0
          }
        ]
      ]
    },
    "Pending reviews": {
      "main": [
        [
          {
            "node": "Evaluate thresholds",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Evaluate thresholds": {
      "main": [
        [
          {
            "node": "Any alert?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Any alert?": {
      "main": [
        [
          {
            "node": "Alert: channel is email?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Alert: send email": {
      "main": [
        [
          {
            "node": "Log alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Alert: send webhook": {
      "main": [
        [
          {
            "node": "Log alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
