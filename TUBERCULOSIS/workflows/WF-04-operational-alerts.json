{
  "name": "WF-04 Operational alerts",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/30 * * * *"
            }
          ]
        }
      },
      "id": "0fade134-1535-439f-8bdc-3c462db5a442",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.TB_API_URL }}/dashboard/summary",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.N8N_API_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "2ad49ebe-b14d-49aa-8e9b-6876436bc39d",
      "name": "Dashboard summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.TB_API_URL }}/ops/pending-review",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.N8N_API_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "1f709e08-78ba-4dc8-8e4e-bf1dab5e2d34",
      "name": "Pending reviews",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "// Thresholds from env; only aggregate counts go into a message (no case ids).\nconst sum = $('Dashboard summary').first().json, pend = $('Pending reviews').first().json;\nconst maxPend = Number($env.ALERT_PENDING_REVIEW_MAX || 10), maxFail = Number($env.ALERT_FAILURES_MAX || 0);\nconst alerts = [];\nif (sum.operational.technical_failures > maxFail) alerts.push('technical failures: ' + sum.operational.technical_failures);\nif (pend.count > maxPend) alerts.push('cases pending review: ' + pend.count);\nconst demo = sum.is_demo ? ' [DEMO MODE]' : '';\nreturn [{json: {count: alerts.length, text: 'TB screening alert' + demo + ' - ' + alerts.join('; ')}}];"
      },
      "id": "a02710f5-f233-4629-8961-6fd0e8b66c6d",
      "name": "Evaluate thresholds",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.count }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "52486f23-4dc6-48ee-8c4c-4960c83322a0",
      "name": "Any alert?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1040,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $env.ALERT_CHANNEL }}",
              "rightValue": "email",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "be3b8fa1-53db-4a58-8b43-8d1680556f59",
      "name": "Alert: channel is email?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1300,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.ALERT_EMAIL_FROM }}",
        "toEmail": "={{ $env.ALERT_EMAIL_TO }}",
        "subject": "TB screening operational alert",
        "emailFormat": "text",
        "text": "={{ $json.text }}",
        "options": {}
      },
      "id": "9d61fb57-945c-4aed-8cec-b4684d911884",
      "name": "Alert: send email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1560,
        300
      ],
      "credentials": {
        "smtp": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "TB SMTP"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ALERT_WEBHOOK_URL }}",
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({text: $json.text}) }}"
      },
      "id": "61d6680a-4705-4646-8263-8efe3aceeb7e",
      "name": "Alert: send webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1820,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TB_API_URL }}/ops/events",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.N8N_API_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({workflow: 'WF-04', event: 'alert_sent', outcome: 'success', detail: {count: $('Evaluate thresholds').first().json.count}}) }}"
      },
      "id": "e9a99a0e-0381-4249-891c-894332453b14",
      "name": "Log alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2080,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
  ],
  "connections": {
    "Alert: channel is email?": {
      "main": [
        [
          {
            "node": "Alert: send email",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Alert: send webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
